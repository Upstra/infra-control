DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=motdepassefort
REDIS_USERNAME=default
REDIS_TLS=false

JWT_SECRET=jwt_secret
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d
JWT_2FA_TOKEN_EXPIRATION=5m
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# Rate Limiting Configuration
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=1000

# Auth Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_STRICT_MAX=5
RATE_LIMIT_AUTH_MODERATE_MAX=10

# Sensitive Operations Rate Limiting
RATE_LIMIT_SENSITIVE_WINDOW_MS=3600000
RATE_LIMIT_SENSITIVE_MAX=3

# API Usage Rate Limiting
RATE_LIMIT_API_WINDOW_MS=300000
RATE_LIMIT_API_MAX=100

GITHUB_TOKEN=github_pat_XX

FRONT_REPO=Upstra/infra-control_front
BACK_REPO=Upstra/infra-control

# Variables manquantes ajoutées
JWT_REFRESH_SECRET=your_jwt_refresh_secet
SESSION_SECRET=your_session_secret

# Variables Swagger et autres
SETUP_KEY=setup_key_secure_change_me_in_production
SWAGGER_TITLE=Infra Control API
SWAGGER_DESCRIPTION=Infrastructure management API
SWAGGER_VERSION=0.8.8

# Variables Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=
MAIL_FROM=
# UPS telemetry polling
UPS_POLL_CRON=*/1 * * * *
UPS_POLL_ON_BATTERY_SECONDS=15
UPS_BATTERY_CACHE_TTL_SECONDS=300

# VMware telemetry
VMWARE_TELEMETRY_ENABLED=true
VMWARE_METRICS_INTERVAL_SECONDS=60
VMWARE_EVENTS_INTERVAL_SECONDS=30
VM_CPU_WARN_PERCENT=90
VM_HIGH_PRIORITY_MAX=10
VMWARE_SERVICE_ACCOUNT=

# iLO Redfish health
ILO_HEALTH_ENABLED=true
ILO_HEALTH_INTERVAL_SECONDS=120
ILO_HEALTH_CONCURRENCY=4

# Metrics history
PROMETHEUS_URL=http://prometheus:9090

# Migration plans
MIGRATION_PLAN_TIMEOUT_MS=1800000

# Python scripts security
PYTHON_VERIFY_SSL=false
PYTHON_CA_BUNDLE=
