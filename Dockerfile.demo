# Demo Dockerfile — extends the backend with the Python environment needed for
# ups_manager scripts (bash, python3, pyvmomi, etc.).
#
# Build context must be the project root (upstra/), not infra-control/:
#   docker compose --env-file .env.demo -f docker-compose.demo.yml up --build

FROM node:20-slim AS base

RUN addgroup --gid 1001 nodegroup && adduser --uid 1001 --ingroup nodegroup --disabled-password nodeuser
RUN npm i -g pnpm

FROM base AS dependencies

WORKDIR /app
COPY --chown=nodeuser:nodegroup infra-control/package.json infra-control/pnpm-lock.yaml ./
RUN pnpm install

FROM base AS build

WORKDIR /app
COPY --chown=nodeuser:nodegroup infra-control/ .
COPY --from=dependencies /app/node_modules ./node_modules
RUN pnpm build
RUN pnpm prune --prod

FROM base AS deploy

# bash + curl for ups_manager scripts; python3 for pyvmomi & inline commands
RUN apt-get update && apt-get install -y \
    bash curl netcat-traditional iputils-ping \
    python3 python3-pip && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps required by ups_manager scripts
COPY ups_manager/requirements.txt /tmp/ups_requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/ups_requirements.txt

# Copy ups_manager scripts and create a fake .venv stub so the venv-check
# guard in each .sh script passes even though Python is installed globally.
RUN mkdir -p /home/upstra
COPY --chown=nodeuser:nodegroup ups_manager/ /home/upstra/ups_manager/
RUN mkdir -p /home/upstra/ups_manager/.venv/bin && \
    printf '#!/bin/sh\n# Demo stub — Python deps are installed globally in this image.\nVIRTUAL_ENV="$(pwd)/.venv"\nexport VIRTUAL_ENV\n' \
      > /home/upstra/ups_manager/.venv/bin/activate && \
    chmod +x /home/upstra/ups_manager/.venv/bin/activate && \
    chown -R nodeuser:nodegroup /home/upstra

WORKDIR /app
COPY --chown=nodeuser:nodegroup --from=build /app/dist ./dist
COPY --chown=nodeuser:nodegroup --from=build /app/node_modules ./node_modules
COPY --chown=nodeuser:nodegroup --from=build /app/package.json ./package.json
COPY --chown=nodeuser:nodegroup --from=build /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --chown=nodeuser:nodegroup infra-control/scripts/docker-entrypoint.sh ./scripts/

RUN chmod +x ./scripts/docker-entrypoint.sh

USER nodeuser
ENTRYPOINT ["./scripts/docker-entrypoint.sh"]
CMD ["pnpm", "run", "start:prod"]
